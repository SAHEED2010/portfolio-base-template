# Copy to .env.local and fill in — see FORKING.md step 3.
# Both values come from the Supabase dashboard: Settings → API.
#
# NEXT_PUBLIC_ prefix means Next.js inlines these into the browser
# bundle at build time — that's fine here, the anon key is designed
# to be public and is governed entirely by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOT read by the app itself — only used as a one-off terminal env var
# for the local verification scripts in FORKING.md step 3. Never put
# this in .env.local or in Vercel; it bypasses RLS entirely.
# SUPABASE_SERVICE_ROLE_KEY=
